{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|loading|disabled|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, loading, disabled, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandidateRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|pageType|method|status|interval|actions|style|key|ref|className|style|children)$/]",
        "message": "<CandidateRow> doesn't accept that prop. Declared props: url, pageType, method, status, interval, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandidateRow'] > JSXAttribute[name.name='method'] > Literal[value!=/^(?:RULE|LLM|MANUAL)$/]",
        "message": "<CandidateRow> method must be one of 'RULE' | 'LLM' | 'MANUAL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandidateRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:SUGGESTED|ACTIVE|DISCARDED)$/]",
        "message": "<CandidateRow> status must be one of 'SUGGESTED' | 'ACTIVE' | 'DISCARDED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:clickable|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: clickable, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:changeType|summary|target|detectedAt|isSimulated|detail|style|key|ref|className|style|children)$/]",
        "message": "<ChangeRow> doesn't accept that prop. Declared props: changeType, summary, target, detectedAt, isSimulated, detail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeTypeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|showIcon|style|key|ref|className|style|children)$/]",
        "message": "<ChangeTypeBadge> doesn't accept that prop. Declared props: type, showIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompetitorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|website|activeTargets|recentChanges|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<CompetitorCard> doesn't accept that prop. Declared props: name, website, activeTargets, recentChanges, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|message|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, message, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTypeLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|method|style|key|ref|className|style|children)$/]",
        "message": "<PageTypeLabel> doesn't accept that prop. Declared props: type, method, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTypeLabel'] > JSXAttribute[name.name='method'] > Literal[value!=/^(?:RULE|LLM|MANUAL)$/]",
        "message": "<PageTypeLabel> method must be one of 'RULE' | 'LLM' | 'MANUAL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItemSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<SidebarItemSpec> doesn't accept that prop. Declared props: value, label, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SimulatedBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<SimulatedBadge> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|favorable|trend|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, icon, favorable, trend, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error|warning|favorable|brand|muted)$/]",
        "message": "<StatusBadge> tone must be one of 'success' | 'error' | 'warning' | 'favorable' | 'brand' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|breadcrumb|meta|actions|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, breadcrumb, meta, actions, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
